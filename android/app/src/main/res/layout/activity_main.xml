<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="48dp" />

        <View
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/circle_glow" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cover"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-20dp"
            android:contentDescription="Cloud Phone"
            android:scaleType="fitCenter"
            android:src="@drawable/cover_phone"
            app:shapeAppearanceOverlay="@style/RoundedCover" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Андроид-облако в один тап"
            android:textColor="#B3C7FF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="#8FA4E8"
            android:textSize="13sp"
            android:text="Подключение к cloud-phone…" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/launch_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="@string/launch"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:backgroundTint="@color/launch_gradient_end"
            app:icon="@drawable/ic_rocket"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:iconPadding="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/settings"
            android:textSize="15sp"
            app:cornerRadius="18dp"
            app:strokeColor="#5D79FF"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconTint="#B3C7FF"
            app:iconPadding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="v1.0.0  ·  требует запущенный сервер cloud-phone"
            android:textColor="#61729F"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>